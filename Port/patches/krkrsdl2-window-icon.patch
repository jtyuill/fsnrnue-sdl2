+bool TVPWindowWindow::SetIcon(SDL_Surface *icon)
+{
+	if (!this->window || !icon)
+	{
+		return false;
+	}
+	SDL_SetWindowIcon(this->window, icon);
+	return true;
+}
+
+bool TVPSetApplicationIcon(const ttstr &name)
+{
+	tjs_string name_utf16 = name.AsStdString();
+	std::string name_utf8;
+	if (!TVPUtf16ToUtf8(name_utf8, name_utf16))
+	{
+		return false;
+	}
+
+	SDL_Surface *icon = SDL_LoadBMP(name_utf8.c_str());
+	if (!icon)
+	{
+		return false;
+	}
+
+	bool applied = false;
+	for (TVPWindowWindow *window = _lastWindowWindow; window; window = window->GetPreviousWindow())
+	{
+		applied = window->SetIcon(icon) || applied;
+	}
+	SDL_FreeSurface(icon);
+	return applied;
+}
