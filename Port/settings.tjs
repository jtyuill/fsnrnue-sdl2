(function()
{
    var platformName = global.System.platformName;
    if (platformName !== "Linux" && platformName !== "Mac OS X")
        return;

    Scripts.eval("@set(USE_KRMEMPLUGIN=0)\n"
        + "@set(USE_WUFFMPEG=0)\n"
        + "@set(USE_KRMPV=0)\n"
        + "@set(USE_KR_VARIOUS_PLUGINS=0)\n"
        + "@set(USE_IMAGELOADER_REPLACEMENTS=0)\n"
        + "@set(USE_LAYER_IMAGEFUNCTION_REPLACEMENTS=0)\n"
        + "@set(USE_MENU_LAYER=1)");

    global.portMenuCaption = function(caption)
    {
        if (typeof(caption) !== "String")
            return caption;

        return caption.replace(/\s*\(&[^)]*\)/g, "")
            .replace(/&/g, "")
            .replace(/\s+/g, " ")
            .trim();
    };

    global.portMenuScale = function(window)
    {
        // One shared scale source so item sizing, margins, and hit-test
        // bands always agree, whatever the window shape.
        return global.Math.max(1.0, global.Math.min(
            window.primaryLayer.width / 800.0,
            window.primaryLayer.height / 600.0));
    };

    global.updatePortMenuActiveHeight = function(root)
    {
        var height = root.menu_active_base_height;
        var stack = root.menu_stack;
        for (var i = 0; i < stack.count; i += 1)
        {
            var item = stack[i];
            if (typeof(item) === "Object" && isvalid(item))
                height = global.Math.max(height, item.top + item.height);
        }

        root.menu_active_height = height;
        return height;
    };


    global.installPortMenuStyle = function()
    {
        var installed_state = typeof(global.portMenuStyleInstalled);
        if (installed_state !== "undefined" && installed_state !== "void")
        {
            global.Debug.notice("[Native] Scaled menu layer already installed.");
            return true;
        }
        if (typeof(global.MenuItemChildLayer) !== "Object"
            || typeof(global.kag) !== "Object"
            || typeof(global.kag.menu_layer) !== "Object")
        {
            return false; // caller decides whether to retry
        }

        var override_state = typeof(global.portMenuItemChildLayerOverride);
        var already_wrapped = false;
        if (override_state !== "undefined" && override_state !== "void")
        {
            if (global.MenuItemChildLayer === global.portMenuItemChildLayerOverride)
                already_wrapped = true;
        }
        if (!already_wrapped) global.Scripts.eval(
            "global.MenuItemChildLayer_port_original = global.MenuItemChildLayer;\n"
            + "class MenuItemChildLayer_port_override extends global.MenuItemChildLayer_port_original\n"
            + "{\n"
            + "\tvar display_caption;\n"
            + "\tvar menu_padding_x;\n"
            + "\tvar menu_padding_y;\n"
            + "\n"
            + "\tfunction MenuItemChildLayer_port_override()\n"
            + "\t{\n"
            + "\t\tsuper.MenuItemChildLayer(...);\n"
            + "\t\tvar scale = global.portMenuScale(this.window);\n"
            + "\t\tthis.font.height = int(this.font.height * scale + 0.5);\n"
            + "\t\tthis.menu_padding_x = int(6 * scale + 0.5);\n"
            + "\t\tthis.menu_padding_y = int(2 * scale + 0.5);\n"
            + "\t\tthis.display_caption = global.portMenuCaption(this.menu.caption);\n"
            + "\t\tvar w = this.font.getTextWidth(this.display_caption) + this.menu_padding_x * 2;\n"
            + "\t\tvar h = this.font.getTextHeight(this.display_caption) + this.menu_padding_y * 2;\n"
            + "\t\tthis.setImageSize(w, h);\n"
            + "\t\tthis.setSizeToImageSize();\n"
            + "\t\tthis.drawState();\n"
            + "\t\tthis.visible = true;\n"
            + "\t}\n"
            + "\n"
            + "\tfunction MenuItemChildLayer()\n"
            + "\t{\n"
            + "\t\tthis.MenuItemChildLayer_port_override(...);\n"
            + "\t}\n"
            + "\n"
            + "\tfunction drawState(hovered=false)\n"
            + "\t{\n"
            // Translucent fills on the alpha face keep the game faintly
            // visible behind the bar and avoid the hard opaque box.
            + "\t\tthis.face = global.dfAlpha;\n"
            + "\t\tvar fill = 0x00000000;\n"
            + "\t\tif (hovered) fill |= 0xB4000000 | 0x00008080;\n"
            + "\t\tif (this.menu.checked && !(this.menu.radio)) fill |= 0x96000000 | 0x00008000;\n"
            + "\t\tif (this.menu.checked && this.menu.radio) fill |= 0x96000000 | 0x00800000;\n"
            + "\t\tthis.fillRect(0, 0, this.imageWidth, this.imageHeight, fill);\n"
            + "\t\tvar caption = this.display_caption;\n"
            + "\t\tvar padding_x = this.menu_padding_x;\n"
            + "\t\tvar padding_y = this.menu_padding_y;\n"
            + "\t\tif (caption === void)\n"
            + "\t\t{\n"
            + "\t\t\tcaption = global.portMenuCaption(this.menu.caption);\n"
            + "\t\t\tpadding_x = 0;\n"
            + "\t\t\tpadding_y = 0;\n"
            + "\t\t}\n"
            + "\t\tthis.drawText(padding_x, padding_y, caption,\n"
            + "\t\t\t(this.menu.enabled ? (hovered ? 0xFFFFFF : 0xE8E8E8) : 0x707070),\n"
            + "\t\t\t255, true);\n"
            + "\t}\n"
            + "\n"
            + "\tfunction onClick()\n"
            + "\t{\n"
            + "\t\tif (!this.menu.enabled)\n"
            + "\t\t\treturn;\n"
            + "\t\tif (this.menu.children.count === 0)\n"
            + "\t\t{\n"
            + "\t\t\tthis.menu.onClick();\n"
            + "\t\t\tthis.root.hide(true);\n"
            + "\t\t}\n"
            + "\t}\n"
            + "}\n"
            + "global.portMenuItemChildLayerOverride = MenuItemChildLayer_port_override;\n"
            + "global.MenuItemChildLayer = global.portMenuItemChildLayerOverride;\n");

        var root = global.kag.menu_layer;
        root.port_hide_original = root.hide;
        root.hide = function(force=false)
        {
            if (!force && this.visible)
            {
                var active_height = global.updatePortMenuActiveHeight(this);
                var scale = global.portMenuScale(this.window);
                var margin = int(12 * scale + 0.5);
                // Layer-relative cursor: exact regardless of where the menu
                // layer is mounted inside the primary layer tree.
                var cursor_x = this.cursorX;
                var cursor_y = this.cursorY;

                if (cursor_x >= -margin && cursor_x < this.imageWidth + margin
                    && cursor_y >= -margin && cursor_y <= active_height + margin)
                    return;
            }

            var result = (this.port_hide_original incontextof this)();
            this.menu_active_height = this.menu_active_base_height;
            return result;
        };
        root.portHideInstalled = true;

        global.portMenuStyleInstalled = true;
        global.Debug.notice("[Native] Scaled menu layer enabled.");
        return true;
    };

    global.portMenuStyleRetries = 0;
    global.portMenuStyleGaveUp = false;
    global.tryInstallPortMenuStyle = function()
    {
        if (global.installPortMenuStyle())
            return;
        if (global.portMenuStyleGaveUp === true)
            return;
        global.portMenuStyleRetries += 1;
        if (global.portMenuStyleRetries > 10)
        {
            global.Debug.notice("[Native] Menu layer class is unavailable; using upstream layout.");
            global.portMenuStyleGaveUp = true;
            return;
        }
        // Menu system not built yet at first event flush; re-arm and try
        // again on the next flush instead of silently giving up.
        global.portMenuStyleTrigger.trigger();
    };

    global.portMenuStyleTrigger = new global.AsyncTrigger(global.tryInstallPortMenuStyle, "");
    global.portMenuStyleTrigger.trigger();

    global.installPortRouteIcons = function()
    {
        if (typeof(global.System.setApplicationIcon) !== "Object")
        {
            global.Debug.notice("[Native] Native window icon support is unavailable.");
            return;
        }

        var basepath = global.System.getArgument("-basepath");
        if (typeof(basepath) !== "String" || basepath === "")
        {
            global.Debug.notice("[Native] Window icon base path is unavailable.");
            return;
        }
        if (basepath.charAt(basepath.length - 1) !== "/")
            basepath += "/";
        global.portIconBasePath = basepath;
        global.portIconCurrentRoute = void;

        global.setRouteIcon = function(route)
        {
            var icon_route = route === global.commonRoute ? global.fateRoute : route;
            if (icon_route === global.fateRoute)
                icon_route = "FATE";
            if (icon_route === global.portIconCurrentRoute)
                return; // already showing this route
            var icon_path = global.portIconBasePath + "linux/icon_" + icon_route + ".bmp";
            if (global.System.setApplicationIcon(icon_path))
                global.portIconCurrentRoute = icon_route;
            else
                global.Debug.notice("[Native] Cannot load window icon: " + icon_path);
        };

        if (typeof(global.setRouteIconAutomatically) === "Object")
            global.setRouteIconAutomatically();
        else
            global.setRouteIcon(global.fateRoute);

        global.Debug.notice("[Native] Route window icon enabled.");
    };

    if (platformName === "Linux")
    {
        global.portRouteIconTrigger = new global.AsyncTrigger(global.installPortRouteIcons, "");
        global.portRouteIconTrigger.trigger();
    }

    global.Plugins.port_native_plugins = %[
        "extrans.dll" => true,
        "fstat.dll" => true,
        "krglhwebp.dll" => true,
        "wutcwf.dll" => true,
        "wuvorbis.dll" => true
    ];

    global.Window.exSystemMenu = void;
    var hooked_state = typeof(global.portLinkHooked);
    if (hooked_state === "undefined" || hooked_state === "void")
    {
        global.Plugins.link_port_original = global.Plugins.link;
        global.portLinkHooked = true;
    }
    global.Plugins.link = function(storage)
    {
        if (global.Plugins.port_native_plugins[storage] === true)
        {
            var result;
            try
            {
                result = global.Plugins.link_port_original(storage);
            }
            catch(e)
            {
                global.Debug.notice("[Native] Native plugin failed to load: "
                    + storage + " (" + e.message + ")");
                return false;
            }
            global.Debug.notice("[Native] Native plugin loaded: " + storage);
            return result;
        }

        global.Debug.notice("[Native] Windows-only plugin skipped: " + storage);
        return false;
    };

    global.Plugins.link("krglhwebp.dll");
})();
